#!/usr/bin/env bash
# A float behind a fullscreen window must not claim a tube.
#
#   test/probe-hidden-float
#
# THE BUG. Clients were selected by workspace, and a float behind a fullscreen
# window is still mapped, still listed and still on that workspace. Nothing draws
# it, but its tube stayed in the shader, so the fullscreen picture got a bent
# rectangle with a black bezel where the float sat. Seen 2026-11-04 in omarchy-crt's
# sealed seat with a 700x420 float behind a fullscreen tile.
#
# Floats claim ahead of tiles, which is what lets a hidden one through. Fullscreen mode
# 2 hides what is behind it. Mode 1 is maximised and does not cover a float, and a window
# allowed over fullscreen is drawn above it, so both keep a tube. A tile behind fullscreen
# also keeps its rect, on purpose: focus order means it is never reached.
REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PASS=0; FAIL=0
ok()  { PASS=$((PASS+1)); printf '  ok   %s\n' "$1"; }
bad() { FAIL=$((FAIL+1)); printf '  FAIL %s\n' "$1"; printf '       %s\n' "${2:-}"; }

S="$(mktemp -d)"; trap 'rm -rf "$S"' EXIT
mkdir -p "$S/bin"

MON='[{"id":0,"name":"DP-1","x":0,"y":0,"width":1920,"height":1080,"scale":1,"transform":0,"activeWorkspace":{"id":1,"name":"1"},"specialWorkspace":{"id":0,"name":""}}]'

win() { # class ws fullscreen floating extra
  printf '{"address":"0x%s","class":"%s","mapped":true,"hidden":false,"monitor":0,"workspace":{"id":%s,"name":"%s"},"at":[100,100],"size":[700,420],"floating":%s,"fullscreen":%s,"focusHistoryID":1%s}' \
    "$RANDOM" "$1" "$2" "$2" "$4" "$3" "${5:-}"
}

mk_hyprctl() {
  cat >"$S/bin/hyprctl" <<STUB
#!/usr/bin/env bash
case "\$1" in
  monitors) cat <<'J'
$MON
J
  ;;
  clients)  cat <<'J'
[$1]
J
  ;;
  layers)   echo '{}' ;;
esac
exit 0
STUB
  chmod +x "$S/bin/hyprctl"
}

surfaces() {
  PATH="$S/bin:$REPO/bin:$PATH" bash -c \
    "source '$REPO/bin/td-tubes'; describe \"\$(cap \"\$(tubes_json)\")\"" 2>/dev/null
}

claims() { # text class wanted
  # No output is a broken harness, and it must not read as "claims nothing".
  grep -q 'tube(s)' <<<"$1" || return 1
  if grep -q "$2" <<<"$1"; then got=yes; else got=no; fi
  [[ "$got" == "$3" ]]
}

echo "a float behind a fullscreen window must not claim"
echo

mk_hyprctl "$(win big 1 2 false),$(win float 1 0 true)"
OUT="$(surfaces)"
claims "$OUT" float no && ok "a float behind fullscreen claims nothing" || bad "a float behind fullscreen claims nothing" "$OUT"
claims "$OUT" big yes && ok "and the fullscreen window keeps its claim" || bad "and the fullscreen window keeps its claim" "$OUT"

mk_hyprctl "$(win big 1 2 false),$(win tile 1 0 false)"
OUT="$(surfaces)"
claims "$OUT" tile yes && ok "a tile behind fullscreen keeps its rect, unreachable behind it" || bad "a tile behind fullscreen keeps its rect, unreachable behind it" "$OUT"

mk_hyprctl "$(win big 1 1 false),$(win float 1 0 true)"
OUT="$(surfaces)"
claims "$OUT" float yes && ok "a maximised window hides nothing" || bad "a maximised window hides nothing" "$OUT"

mk_hyprctl "$(win big 1 2 false),$(win over 1 0 true ',"allowedOverFullscreen":true')"
OUT="$(surfaces)"
claims "$OUT" over yes && ok "a window allowed over fullscreen keeps its claim" || bad "a window allowed over fullscreen keeps its claim" "$OUT"

mk_hyprctl "$(win float 1 0 true),$(win big 2 2 false)"
OUT="$(surfaces)"
claims "$OUT" float yes && ok "fullscreen on another workspace hides nothing here" || bad "fullscreen on another workspace hides nothing here" "$OUT"

echo
echo "  $PASS passed, $FAIL failed"
[[ $FAIL -eq 0 ]]
